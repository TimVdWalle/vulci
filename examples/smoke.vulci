// Phase 7
/*
Vulci smoke test
Implemented phases: 1–7
Expected output:
1129
true
null
*/
// Integer literals, assignments, reassignment, lookup, and arithmetic.
value = 1
value = value + 1
arithmetic = value + 2 * 3 + (1 + 2) * 3 + 20 - 5 - 3 + 52 / 2 / 2 + -(-9) + (-35 / 2) + (-37 % 10) + 1_000
// Line comment.
line_comment = 1 // ignored
// Block comment between tokens.
block_comment = 1 /* ignored */ + 1
// Multiline block comment inside an expression.
multiline_comment = 1 + /*
ignored
*/ 2
// Nested block comments.
nested_comment = 1 + /*
outer
/* inner */
/* another /* deeper */ nested comment */
*/ 3
/// Documentation-style line comments are ordinary comments.
/**
 * Documentation-style block comments are ordinary comments.
 */
// Identifiers may contain underscores and digits.
smoke_value_2 = line_comment + block_comment + multiline_comment + nested_comment
// Boolean literals, equality, ordering comparisons, and precedence.
comparison_result = true == true and false == false and 1 == 1 and 1 != 2 and 1 < 2 and 2 <= 2 and 3 > 2 and 3 >= 3 and 1 + 2 == 3 and 2 * 3 > 5 and (1 < 2) == true
// not, repeated not, and, or, and short-circuit evaluation.
logical_result = not false and not not true and (false or true) and not (false and 1 / 0 == 0)
// Basic conditional, else-if, and assignment from a conditional.
conditional_result = if (false) {
    0
} else if (comparison_result and logical_result) {
    20
} else {
    0
}
// Multiple expressions use the final expression as the branch result.
// Assignments inside branches reuse the current environment.
branch_value = 0
branch_result = if (true) {
    branch_value = 5
    branch_value + 1
} else {
    0
}
// Only the selected branch is evaluated.
selected_branch = if (true) {
    8
} else {
    1 / 0
}
// Nested conditional expressions.
nested_result = if (true) {
    if (false) {
        0
    } else {
        7
    }
} else {
    0
}
// Ordering and equality comparison chains.
chain_counter = 0
chain_result = 0 < (chain_counter = chain_counter + 1) < 2 and 1 < 2 <= 3 and 1 == 1 != 2 and not (1 < 2 > 3)
// Chained comparisons short-circuit.
chain_short_circuit = not (10 < 5 < 1 / 0)
// Function with parameters and explicit return.
fn add(left, right) {
    return left + right
}
// Zero-argument function and implicit return.
fn implicit_result() {
    6
}
// return without a value.
fn return_null() {
    return
}
// Function-local assignment does not change the top-level variable.
local_value = 10
fn local_scope() {
    local_value = 11
    return local_value
}
// Declared globals can be read and updated inside functions.
$global_value = 1
fn increment_global() {
    $global_value = $global_value + 1
    return $global_value
}
// Direct recursion.
fn recurse(value) {
    if (value == 0) {
        return 4
    }
    return recurse(value - 1)
}
// Mutual recursion.
fn is_even(value) {
    if (value == 0) {
        return true
    }
    return is_odd(value - 1)
}
fn is_odd(value) {
    if (value == 0) {
        return false
    }
    return is_even(value - 1)
}
// Forward call: functions are registered before top-level evaluation.
forward_result = declared_later()
fn declared_later() {
    return 5
}
// Missing else evaluates to null.
missing_else = if (false) {
    1
}
// One compact integer checksum.
checksum = arithmetic + smoke_value_2 + conditional_result + branch_result + branch_value + selected_branch + nested_result + chain_counter + add(2, 3) + implicit_result() + local_scope() + local_value + increment_global() + $global_value + recurse(3) + forward_result
// One compact Boolean check.
all_features_work = comparison_result and logical_result and chain_result and chain_short_circuit and is_even(10) and not is_even(9)
print(checksum)
print(all_features_work)
print(missing_else)
// Execute return-without-value without adding another output.
unused_null = return_null()