// Phase 10
/*
Vulci smoke test
Implemented phases: 1–10

Expected standard output:
SMOKE OK: 1285

Expected warnings:
- Omitted parameter types
- Omitted return types
*/

// Integer literals, assignments, reassignment, lookup, and arithmetic.
value = 1
value = value + 1
arithmetic = value
    + 2 * 3
    + (1 + 2) * 3
    + 20
    - 5
    - 3
    + 52 / 2 / 2
    + -(-9)
    + (-35 / 2)
    + (-37 % 10)
    + 1_000

// Line comment.
line_comment = 1 // ignored

// Block comment between tokens.
block_comment = 1 /* ignored */ + 1

// Multiline block comment inside an expression.
multiline_comment = 1 + /*
ignored
*/ 2

// Nested block comments.
nested_comment = 1 + /*
outer
/* inner */
/* another /* deeper */ nested comment */
*/ 3

/// Documentation-style line comments are ordinary comments.

/**
 * Documentation-style block comments are ordinary comments.
 */

// Identifiers may contain underscores and digits.
smoke_value_2 = line_comment
    + block_comment
    + multiline_comment
    + nested_comment

// Boolean literals, equality, ordering comparisons, and precedence.
comparison_result = true == true
    and false == false
    and 1 == 1
    and 1 != 2
    and 1 < 2
    and 2 <= 2
    and 3 > 2
    and 3 >= 3
    and 1 + 2 == 3
    and 2 * 3 > 5
    and (1 < 2) == true

// not, repeated not, and, or, and short-circuit evaluation.
logical_result = not false
    and not not true
    and (false or true)
    and not (false and 1 / 0 == 0)

// Basic conditional, else-if, and assignment from a conditional.
conditional_result = if (false) {
    0
} else if (comparison_result and logical_result) {
    20
} else {
    0
}

// Multiple expressions use the final expression as the branch result.
branch_value = 0
branch_result = if (true) {
    branch_value = 5
    branch_value + 1
} else {
    0
}

// Only the selected branch is evaluated.
selected_branch = if (true) {
    8
} else {
    1 / 0
}

// Nested conditional expressions.
nested_result = if (true) {
    if (false) {
        0
    } else {
        7
    }
} else {
    0
}

// Ordering and equality comparison chains.
chain_counter = 0
chain_result = 0 < (chain_counter = chain_counter + 1) < 2
    and 1 < 2 <= 3
    and 1 == 1 != 2
    and not (1 < 2 > 3)

// Chained comparisons short-circuit.
chain_short_circuit = not (10 < 5 < 1 / 0)

// Typed parameters and explicit return.
fn add(int left, int right) returns int {
    return left + right
}

// Zero-argument function and implicit return.
fn implicit_result() returns int {
    6
}

// Bare return produces null.
fn return_null() returns null {
    return
}

// Function-local assignment does not change the top-level variable.
local_value = 10

fn local_scope() returns int {
    local_value = 11
    return local_value
}

// Declared globals can be read and updated inside functions.
$global_value = 1

fn increment_global() returns int {
    $global_value = $global_value + 1
    return $global_value
}

// Direct recursion.
fn recurse(int value) returns int {
    if (value == 0) {
        return 4
    }

    return recurse(value - 1)
}

// Mutual recursion.
fn is_even(int value) returns bool {
    if (value == 0) {
        return true
    }

    return is_odd(value - 1)
}

fn is_odd(int value) returns bool {
    if (value == 0) {
        return false
    }

    return is_even(value - 1)
}

// Forward call: functions are registered before top-level evaluation.
forward_result = declared_later()

fn declared_later() returns int {
    return 5
}

// Missing else evaluates to null.
missing_else = if (false) {
    1
}

// Typed parameter reassignment.
fn typed_increment(int value) returns int {
    value = value + 1
    value
}

// Parameter and return unions.
fn preserve(int|bool value) returns int|bool {
    value
}

// Nullable return union.
fn positive_or_null(int value) returns int|null {
    if (value > 0) {
        return value
    }

    null
}

// A union parameter may change to another union member.
fn switch_type(int|bool value) returns int|bool {
    value = true
    value
}

// Explicit any is accepted without a warning.
fn explicit_any(any value) returns any {
    value
}

// Omitted annotations become any and produce normal warnings.
fn implicit_any(value) {
    value
}

// Whitespace around union separators is valid without warnings.
fn spaced_union(int | bool value) returns int | null {
    if (value == true) {
        return 6
    }

    null
}

// Phase 9: optional parameters, defaults, and trailing parameter comma.
fn phase9_calculate(
    int left,
    int right,
    int multiplier=2,
    int offset=declared_later(),
) returns int {
    (left + right) * multiplier + offset
}

// Phase 9: defaults are evaluated separately for each omission.
$default_counter = 0

fn next_default() returns int {
    $default_counter = $default_counter + 1
    $default_counter
}

fn phase9_default(int value=next_default()) returns int {
    value
}

// Named required arguments may be reordered.
phase9_named = phase9_calculate(
    right: 3,
    left: 4,
    multiplier: 5,
    offset: 1,
)

// Up to two required arguments may be positional.
// Optional arguments are named.
phase9_mixed = phase9_calculate(
    4,
    3,
    multiplier: 5,
    offset: 1,
)

// Omitted optional arguments use their defaults.
phase9_defaults = phase9_calculate(4, 3)

// Trailing argument comma.
phase9_trailing = phase9_calculate(
    4,
    3,
    multiplier: 1,
)

// Defaults are evaluated once per omission.
phase9_first_default = phase9_default()
phase9_second_default = phase9_default()

// Supplying the optional argument prevents default evaluation.
phase9_supplied_default = phase9_default(value: 10)

// Bare zero-argument function call.
phase9_bare_call = declared_later

// Existing feature checksum.
checksum = arithmetic
    + smoke_value_2
    + conditional_result
    + branch_result
    + branch_value
    + selected_branch
    + nested_result
    + chain_counter
    + add(2, 3)
    + implicit_result()
    + local_scope()
    + local_value
    + increment_global()
    + $global_value
    + recurse(3)
    + forward_result

all_features_work = comparison_result
    and logical_result
    and chain_result
    and chain_short_circuit
    and is_even(10)
    and not is_even(9)

// Convert Boolean and null checks into integer checksum contributions.
existing_boolean_score = if (all_features_work) {
    1
} else {
    0
}

existing_null_score = if (missing_else == null) {
    1
} else {
    0
}

// Phase 8 contributions.
typed_reassignment_score = typed_increment(1)
union_integer_score = preserve(3)

union_boolean_score = if (preserve(true)) {
    1
} else {
    0
}

nullable_score = if (positive_or_null(-1) == null) {
    1
} else {
    0
}

union_reassignment_score = if (switch_type(1)) {
    1
} else {
    0
}

explicit_any_score = explicit_any(4)
implicit_any_score = implicit_any(5)
spaced_union_score = spaced_union(true)

// Phase 10 strings.
phase10_name = "Vulci"
phase10_literal = '{{phase10_name}}'
phase10_joined = "Hello" ~ phase10_name + "!"

phase10_multiline = """
    {{phase10_name}}
    text
"""

phase10_interpolation = "n={{1 + 2}}, b={{true}}"

phase10_score = "👨‍👩‍👧‍👦á".count()
    + if (phase10_joined.contains("Vulci")) { 1 } else { 0 }
    + if ("A" < "a") { 1 } else { 0 }
    + if (phase10_literal == '{{phase10_name}}') { 1 } else { 0 }
    + if (phase10_multiline == "Vulci\ntext") { 1 } else { 0 }
    + if (phase10_interpolation == "n=3, b=true") { 1 } else { 0 }
    + if (phase10_joined == "Hello Vulci!") { 1 } else { 0 }

// Phase 9 contribution.
phase9_score = phase9_named
    + phase9_mixed
    + phase9_defaults
    + phase9_trailing
    + phase9_first_default
    + phase9_second_default
    + phase9_supplied_default
    + phase9_bare_call
    + $default_counter

// One final, visually checkable result.
result = checksum
    + existing_boolean_score
    + existing_null_score
    + typed_reassignment_score
    + union_integer_score
    + union_boolean_score
    + nullable_score
    + union_reassignment_score
    + explicit_any_score
    + implicit_any_score
    + spaced_union_score
    + phase9_score
    + phase10_score

// Named native argument, string output, and interpolation.
print(value: "SMOKE OK: {{result}}")

// Execute bare return without adding another printed result.
unused_null = return_null()