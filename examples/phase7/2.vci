// Phase 7

fn fibonacci(number) {
    if (number <= 1) {
        number
    } else {
        fibonacci(number - 1) + fibonacci(number - 2)
    }
}

print(fibonacci(0))
print(fibonacci(1))
print(fibonacci(2))
print(fibonacci(3))
print(fibonacci(4))
print(fibonacci(5))
print(fibonacci(6))
print(fibonacci(7))
print(fibonacci(8))
print(fibonacci(9))
print(fibonacci(10))
