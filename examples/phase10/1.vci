// Phase 10

$name = "Ada"
$language = 'Vulci'

$greeting = "Hello, {{$name}}!"
$description = $language ~ "supports strings"

$multiline = """
    Strings support:
      interpolation
      multiline text
      concatenation
      comparisons
"""

$concatenated = "Vul" + "ci"
$joined = "Hello" ~ "world"

$containsVul = $language.contains("Vul")
$graphemeCount = "👨‍👩‍👧‍👦á".count()

$ordered = "apple" < "banana"
$equal = "Vulci" == $concatenated

print($greeting)
print($description)
print($multiline)
print($joined)
print($containsVul)
print($graphemeCount)
print($ordered)
print($equal)
