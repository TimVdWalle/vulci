<!-- Phase: Phase 14 IDE support -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Vulci</string>
    <key>scopeName</key>
    <string>source.vulci</string>
    <key>fileTypes</key>
    <array>
        <string>vci</string>
    </array>
    <key>uuid</key>
    <string>65BB2800-7D43-459A-A020-7D049F12CC76</string>
    <key>patterns</key>
    <array>
        <dict><key>include</key><string>#comments</string></dict>
        <dict><key>include</key><string>#strings</string></dict>
        <dict>
            <key>name</key><string>meta.declaration.function.vulci</string>
            <key>match</key><string>\b(fn)\s+([A-Za-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>storage.type.function.vulci</string></dict>
                <key>2</key><dict><key>name</key><string>entity.name.function.vulci</string></dict>
            </dict>
        </dict>
        <dict>
            <key>name</key><string>meta.declaration.type.vulci</string>
            <key>match</key><string>\b(struct|enum)\s+([A-Za-z_][A-Za-z0-9_]*)</string>
            <key>captures</key>
            <dict>
                <key>1</key><dict><key>name</key><string>storage.type.vulci</string></dict>
                <key>2</key><dict><key>name</key><string>entity.name.type.vulci</string></dict>
            </dict>
        </dict>
        <dict>
            <key>name</key><string>keyword.control.vulci</string>
            <key>match</key><string>\b(?:if|else|return|returns)\b</string>
        </dict>
        <dict>
            <key>name</key><string>keyword.operator.logical.vulci</string>
            <key>match</key><string>\b(?:and|or|not)\b</string>
        </dict>
        <dict>
            <key>name</key><string>storage.type.vulci</string>
            <key>match</key><string>\b(?:fn|struct|enum)\b</string>
        </dict>
        <dict>
            <key>name</key><string>storage.type.builtin.vulci</string>
            <key>match</key><string>\b(?:int|bool|str|list|set|map|any)\b</string>
        </dict>
        <dict>
            <key>name</key><string>constant.language.vulci</string>
            <key>match</key><string>\b(?:true|false|null)\b</string>
        </dict>
        <dict>
            <key>name</key><string>constant.numeric.integer.vulci</string>
            <key>match</key><string>\b[0-9]+(?:_[0-9]+)*\b</string>
        </dict>
        <dict>
            <key>name</key><string>variable.other.global.vulci</string>
            <key>match</key><string>\$[A-Za-z_][A-Za-z0-9_]*</string>
        </dict>
        <dict>
            <key>name</key><string>keyword.operator.vulci</string>
            <key>match</key><string>==|!=|&lt;=|&gt;=|[=+~*/%|&lt;&gt;-]</string>
        </dict>
        <dict>
            <key>name</key><string>punctuation.separator.vulci</string>
            <key>match</key><string>[,.:]</string>
        </dict>
        <dict>
            <key>name</key><string>punctuation.section.vulci</string>
            <key>match</key><string>[(){}\[\]]</string>
        </dict>
    </array>
    <key>repository</key>
    <dict>
        <key>comments</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>comment.line.double-slash.vulci</string>
                    <key>begin</key><string>//</string>
                    <key>end</key><string>$</string>
                    <key>beginCaptures</key>
                    <dict><key>0</key><dict><key>name</key><string>punctuation.definition.comment.vulci</string></dict></dict>
                </dict>
                <dict><key>include</key><string>#block-comment</string></dict>
            </array>
        </dict>
        <key>block-comment</key>
        <dict>
            <key>name</key><string>comment.block.vulci</string>
            <key>begin</key><string>/\*</string>
            <key>end</key><string>\*/</string>
            <key>patterns</key>
            <array><dict><key>include</key><string>#block-comment</string></dict></array>
        </dict>
        <key>strings</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>string.quoted.triple.double.vulci</string>
                    <key>begin</key><string>"""</string>
                    <key>end</key><string>"""</string>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#escapes</string></dict>
                        <dict><key>include</key><string>#interpolation</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key><string>string.quoted.triple.single.vulci</string>
                    <key>begin</key><string>'''</string>
                    <key>end</key><string>'''</string>
                    <key>patterns</key>
                    <array><dict><key>include</key><string>#escapes</string></dict></array>
                </dict>
                <dict>
                    <key>name</key><string>string.quoted.double.vulci</string>
                    <key>begin</key><string>"</string>
                    <key>end</key><string>"|$</string>
                    <key>patterns</key>
                    <array>
                        <dict><key>include</key><string>#escapes</string></dict>
                        <dict><key>include</key><string>#interpolation</string></dict>
                    </array>
                </dict>
                <dict>
                    <key>name</key><string>string.quoted.single.vulci</string>
                    <key>begin</key><string>'</string>
                    <key>end</key><string>'|$</string>
                    <key>patterns</key>
                    <array><dict><key>include</key><string>#escapes</string></dict></array>
                </dict>
            </array>
        </dict>
        <key>escapes</key>
        <dict>
            <key>patterns</key>
            <array>
                <dict>
                    <key>name</key><string>constant.character.escape.vulci</string>
                    <key>match</key><string>\\[ntr\\"']</string>
                </dict>
                <dict>
                    <key>name</key><string>invalid.illegal.escape.vulci</string>
                    <key>match</key><string>\\.</string>
                </dict>
            </array>
        </dict>
        <key>interpolation</key>
        <dict>
            <key>name</key><string>meta.interpolation.vulci</string>
            <key>begin</key><string>\{\{</string>
            <key>end</key><string>\}\}</string>
            <key>beginCaptures</key>
            <dict><key>0</key><dict><key>name</key><string>punctuation.section.interpolation.begin.vulci</string></dict></dict>
            <key>endCaptures</key>
            <dict><key>0</key><dict><key>name</key><string>punctuation.section.interpolation.end.vulci</string></dict></dict>
            <key>patterns</key>
            <array><dict><key>include</key><string>$self</string></dict></array>
        </dict>
    </dict>
</dict>
</plist>
